[Unit]
Description=AIDefender Linux auditd agent
Documentation=file:///opt/aidf/docs/linux-auditd.md
After=auditd.service network-online.target
Wants=network-online.target
ConditionPathExists=/var/log/audit/audit.log

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aidf
ExecStart=/opt/aidf/venv/bin/python /opt/aidf/aidf_agent.py --config /etc/aidf/agent.toml
Restart=on-failure
RestartSec=5
StateDirectory=aidf
LogsDirectory=aidf
LimitNOFILE=65536
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target

