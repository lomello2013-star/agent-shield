    "platform": {
      "enum": [
        "windows",
        "linux"
      ],
      "title": "Platform",
      "type": "string"
    },
    "signature": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature"
    }
  },
  "required": [
    "case_id",
    "created_at",
    "confirmed_by",
    "features",
    "verdict",
    "platform"
  ],
  "title": "CaseMemoryEntry",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}