          "type": "number"
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "reason_text": {
          "title": "Reason Text",
          "type": "string"
        },
        "actor_pid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
