            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Ts"
        }
      },
      "required": [
        "verdict_id",
        "trace_id",
        "event_id",
        "detector",
        "platform",
        "confidence",
        "severity",
        "reason_code",
        "reason_text"
