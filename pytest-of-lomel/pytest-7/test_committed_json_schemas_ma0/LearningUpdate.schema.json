{
  "$defs": {
    "ModelPack": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "platform": {
          "enum": [
            "windows",
            "linux"
          ],
          "title": "Platform",
          "type": "string"
        },
        "format": {
          "enum": [
            "onnx",
            "gguf"
          ],
          "title": "Format",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "dataset_hash": {
          "title": "Dataset Hash",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "limits": {
          "additionalProperties": true,
          "title": "Limits",
          "type": "object"
        },
        "signature": {
          "minLength": 1,
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "version",
        "platform",
        "format",
        "sha256",
        "dataset_hash",
        "signature"
      ],
      "title": "ModelPack",
      "type": "object"
    },
    "QAPair": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "question",
        "answer",
        "source"
      ],
      "title": "QAPair",
      "type": "object"
    },
    "TaskSolution": {
      "additionalProperties": false,
      "properties": {
        "task": {
          "title": "Task",
          "type": "string"
        },
        "solution": {
          "title": "Solution",
          "type": "string"
        },
        "used_as": {
          "default": "fewshot",
          "enum": [
            "fewshot",
            "training"
          ],
          "title": "Used As",
          "type": "string"
        }
      },
      "required": [
        "task",
        "solution"
      ],
      "title": "TaskSolution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "update_id": {
      "format": "uuid",
      "title": "Update Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "rules": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rules"
    },
    "model_packs": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ModelPack"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Packs"
    },
    "qa_pairs": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/QAPair"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qa Pairs"
    },
    "task_solutions": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/TaskSolution"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Solutions"
    },
    "kb_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kb Version"
    },
    "signature": {
      "minLength": 1,
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "update_id",
    "version",
    "signature"
  ],
  "title": "LearningUpdate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}