{
  "additionalProperties": false,
  "properties": {
    "confirmation_id": {
      "format": "uuid",
      "title": "Confirmation Id",
      "type": "string"
    },
    "action_id": {
      "format": "uuid",
      "title": "Action Id",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    },
    "level": {
      "enum": [
        "critical_system",
        "protected_dir",
        "normal"
      ],
      "title": "Level",
      "type": "string"
    },
    "timeout_sec": {
      "default": 30,
      "minimum": 1,
      "title": "Timeout Sec",
      "type": "integer"
    },
    "decision": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "timeout"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decided_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided By"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    }
  },
  "required": [
    "confirmation_id",
    "action_id",
    "trace_id",
    "level"
  ],
  "title": "Confirmation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}