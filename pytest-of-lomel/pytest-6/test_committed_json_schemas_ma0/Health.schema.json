{
  "additionalProperties": false,
  "properties": {
    "module": {
      "title": "Module",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "degraded",
        "failed",
        "stopped"
      ],
      "title": "Status",
      "type": "string"
    },
    "platform": {
      "anyOf": [
        {
          "enum": [
            "windows",
            "linux"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform"
    },
    "ram_mb": {
      "default": 0.0,
      "minimum": 0,
      "title": "Ram Mb",
      "type": "number"
    },
    "cpu_percent": {
      "default": 0.0,
      "minimum": 0,
      "title": "Cpu Percent",
      "type": "number"
    },
    "queue_depth": {
      "default": 0,
      "minimum": 0,
      "title": "Queue Depth",
      "type": "integer"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    }
  },
  "required": [
    "module",
    "version",
    "status"
  ],
  "title": "Health",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}