[Unit]
Description=STML Fleet Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stml
Group=stml
WorkingDirectory=/opt/stml
Environment=STML_TENANT=default
Environment=STML_DB=/var/lib/stml/stml.sqlite3
Environment=STML_TRUST_DIR=/var/lib/stml/trust
EnvironmentFile=-/etc/stml/stml.env
ExecStart=/opt/stml/venv/bin/python -m stml.server run --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stml
ProtectHome=true

[Install]
WantedBy=multi-user.target
