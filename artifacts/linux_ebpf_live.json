{
  "mode": "exec+cred+mprotect+procmem+ptrace+mem",
  "source": "eBPF CO-RE stream (exec_path, file_open_lsm, mprotect_exec, proc_mem, ptrace_write, mem_write), live",
  "vm": "AIDF-Linux",
  "kernel": "6.8.0-149-generic",
  "lsm": "lockdown,capability,landlock,yama,apparmor,bpf",
  "live_scenarios": [
    {"id": "linux-exec-tmp", "rule": "LINUX-EXEC-TMP-101", "events": 3, "verdicts": 1,
     "control": "cp -> /bin/true: no verdict"},
    {"id": "linux-cred-read", "rule": "LINUX-CRED-READ-104", "events": 2, "verdicts": 1,
     "excluded_auth_daemons": ["sshd"], "control": "cat /etc/shadow"},
    {"id": "linux-mprotect-exec", "rule": "LINUX-EXEC-MEM-107", "events": 5, "verdicts": 5,
     "control": "mprotect_helper adds PROT_EXEC to anonymous pages"},
    {"id": "linux-proc-mem", "rule": "LINUX-INJECT-106", "events": 5, "verdicts": 5,
     "control": "procmem_helper writes /proc/<pid>/mem"},
    {"id": "linux-ptrace", "rule": "LINUX-INJECT-106", "events": 5, "verdicts": 5,
     "control": "ptrace_helper PTRACE_POKEDATA"},
    {"id": "linux-mem-write", "rule": "LINUX-INJECT-106", "events": 5, "verdicts": 5,
     "control": "memwrite_helper process_vm_writev"},
    {"id": "linux-net-c2", "rule": "LINUX-C2-PORT-105", "events": 3, "verdicts": 1,
     "cgroup": "/sys/fs/cgroup", "control": "connect 443: no verdict"},
    {"id": "linux-cron", "rule": "LINUX-CRON-102", "events": 4, "verdicts": 1,
     "control": "touch /etc/cron.d/aidf_rt"},
    {"id": "linux-audit-tamper", "rule": "LINUX-AUDIT-TAMPER-103", "events": 4, "verdicts": 1,
     "control": "touch /var/log/audit/audit.log"},
    {"id": "linux-corr-injection", "rules": ["LINUX-EXEC-CORR-108",
     "LINUX-EXEC-CORR-109", "LINUX-EXEC-CORR-110"], "events": 10, "verdicts": 15,
     "control": "corr_helper: process_vm_writev + mprotect in one process tree"},
    {"id": "linux-smb-lateral", "rule": "NET-SMB-LATERAL-012", "events": 2, "verdicts": 2,
     "control": "connect 445 + 4444"},
    {"id": "linux-mass-write", "rule": "FILE-MASS-WRITE-014", "events": 50, "verdicts": 1,
     "control": "50 x touch /tmp/aidf_write_*"},
    {"id": "linux-canary-delete", "rule": "FILE-CANARY-015", "events": 2, "verdicts": 1,
     "control": "rm /tmp/aidf_canary_test"},
    {"id": "linux-exfil-large", "rule": "NET-EXFIL-LARGE-017", "events": 1, "verdicts": 1,
     "control": "sendto 12 MB UDP"},
    {"id": "linux-dns-long", "rule": "NET-DNS-LONG-013", "events": 2, "verdicts": 1,
     "control": "short qname: no verdict"}
  ],
  "live_count": 17,
  "limitations": [
    "17 of 20 Linux scenarios are live; the other 3 are Windows-only",
    "production collector: systemd unit + install script verified (10 streams, 12 audit lines); signing/queue/log rotation open",
    "fapolicyd was stopped for BPF loader tests and restored afterwards"
  ]
}
